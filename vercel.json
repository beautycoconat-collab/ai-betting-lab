{
  "buildCommand": "node scripts/check_dashboard.mjs",
  "outputDirectory": "public",
  "functions": {
    "api/dashboard.py": {
      "includeFiles": "public/data/dashboard.json",
      "excludeFiles": "{evidence/**,reports/**,data/**,supabase/**,tests*/**,project-source.zip.part-*,*.bundle}"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'none'; style-src-attr 'unsafe-inline'"
        }
      ]
    }
  ]
}
