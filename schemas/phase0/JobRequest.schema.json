{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "idempotency_key": {
      "maxLength": 200,
      "minLength": 8,
      "title": "Idempotency Key",
      "type": "string"
    },
    "kind": {
      "enum": [
        "collect",
        "validate",
        "model",
        "red_team",
        "referee",
        "reanalysis",
        "save_prediction",
        "settle"
      ],
      "title": "Kind",
      "type": "string"
    },
    "fixture_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Fixture Id"
    },
    "max_attempts": {
      "default": 3,
      "maximum": 5,
      "minimum": 1,
      "title": "Max Attempts",
      "type": "integer"
    },
    "timeout_seconds": {
      "default": 300,
      "maximum": 3600,
      "minimum": 1,
      "title": "Timeout Seconds",
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "idempotency_key",
    "kind"
  ],
  "title": "JobRequest",
  "type": "object"
}